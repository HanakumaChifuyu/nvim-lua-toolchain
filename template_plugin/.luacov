return {
  statsfile = "tests/.luacov.stats.out",
  reportfile = "tests/luacov.report.out",
  include = {
    -- Match everything under lua/ regardless of namespace name.
    -- luacov strips .lua before pattern matching, so omit the extension.
    "lua/",
  },
  exclude = {
    "tests/vendor/.*",
    "tests/.rocks/.*",
    "tests/minimal_init",
    "tests/.*_spec",
    ".*/plenary%.nvim/.*",
    ".*/lazy/.*",
    ".*/site/pack/.*",
  },
}
